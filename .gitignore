# Build output
/bin/
/dist/
# Root-anchored: ignore a stray binary built in the repo root (e.g. `go build
# ./cmd/daintree-assistant` with no -o), WITHOUT swallowing the
# cmd/daintree-assistant/ SOURCE directory — an unanchored `daintree-assistant`
# matched that directory too and silently kept the entrypoint un-trackable.
/daintree-assistant
*.exe

# Go test / profiling artifacts
*.test
*.out
coverage/
coverage.txt
coverage.html
*.prof
*.cpu
*.mem

# Local env & secrets
.env
.env.*
!.env.example

# Logs & local state
*.log
logs/
state.db
*.local
.tmp/

# OS / editor
.DS_Store

# In-repo git worktrees (never track as submodules)
/worktrees/
