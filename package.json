{
  "name": "@daintreehq/daintree-assistant",
  "version": "0.1.0",
  "description": "Daintree Assistant CLI — a local orchestration assistant for Daintree, powered by Fireworks AI.",
  "type": "module",
  "bin": {
    "daintree-assistant": "./dist/index.js"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "ui:gallery": "bun run src/ui/dev/gallery.tsx",
    "build": "tsup",
    "start": "bun dist/index.js",
    "db:reset": "rm -rf \"$HOME/.daintree/assistant-cli\" && echo 'Daintree Assistant state reset — a fresh DB builds from SCHEMA on next launch'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && bun test tests/ui",
    "test:unit": "vitest run",
    "test:ui": "bun test tests/ui",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@opentui/core": "0.4.1",
    "@opentui/react": "0.4.1",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "openai": "^4.77.0",
    "react": "^19.2.7",
    "react-reconciler": "^0.33.0",
    "strip-ansi": "^7.2.0",
    "web-tree-sitter": "0.25.10",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/ws": "^8.5.12",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
