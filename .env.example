# Fireworks AI (required for the assistant to think)
FIREWORKS_API_KEY=fw_xxx

# Daintree MCP connection (injected by Daintree when it launches the CLI).
# Leave unset to run in degraded local mode (fs/timer/watcher/queue tools only).
# DAINTREE_MCP_URL=http://127.0.0.1:45454/mcp
# DAINTREE_MCP_TOKEN=...
# DAINTREE_PROJECT_ID=...

# Optional overrides. The commented values below are the built-in DEFAULTS
# (internal/config/config.go) — uncomment only to override.
# DAINTREE_LARGE_MODEL=accounts/fireworks/models/glm-5p2
# DAINTREE_MEDIUM_MODEL=accounts/fireworks/models/glm-5p2   # medium routes to large in v1
# DAINTREE_SMALL_MODEL=accounts/fireworks/models/deepseek-v4-flash
# DAINTREE_ASSISTANT_TIER=operator   # supervisor | operator | system
# DAINTREE_ASSISTANT_STATE_DIR=~/.daintree/assistant-cli
