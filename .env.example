# DeepSeek API (required for the assistant to think). OpenAI-compatible endpoint.
DEEPSEEK_API_KEY=sk-xxx

# Daintree MCP connection (injected by Daintree when it launches the CLI).
# Leave unset to run in degraded local mode (fs/timer/watcher/queue tools only).
# DAINTREE_MCP_URL=http://127.0.0.1:45454/mcp
# DAINTREE_MCP_TOKEN=...
# DAINTREE_PROJECT_ID=...

# Optional overrides. The commented values below are the built-in DEFAULTS
# (internal/config/config.go) — uncomment only to override.
# DAINTREE_LARGE_MODEL=deepseek-v4-flash
# DAINTREE_MEDIUM_MODEL=deepseek-v4-flash   # medium routes to large in v1
# DAINTREE_SMALL_MODEL=deepseek-v4-flash
# DAINTREE_ASSISTANT_TIER=system   # supervisor | operator | system
# DAINTREE_ASSISTANT_STATE_DIR=~/.daintree/assistant-cli
#
# DEEPSEEK_BASE_URL overrides the endpoint (default https://api.deepseek.com). It is a
# trusted-or-own var (real env or the assistant's own .env) — never read from a project
# .env, so a bound repo can't redirect where the key is sent.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
